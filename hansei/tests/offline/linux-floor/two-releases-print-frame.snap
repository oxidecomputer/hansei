async_channel::Recv<u32> {
    receiver: 0xA1 -> async_channel::Receiver<u32> { .. },
    listener: core::option::Option<event_listener::EventListener> = Some {
        inner: alloc::sync::Arc<event_listener::Inner, alloc::alloc::Global> {
            ptr: 0xA2 -> alloc::sync::ArcInner<event_listener::Inner> { .. },
        },
        entry: core::option::Option<core::ptr::non_null::NonNull<event_listener::Entry>> { .. } @ 0xA3,
    },
}
