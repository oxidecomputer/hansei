    tcp: fd N
        stream: 0xA1 tokio::net::tcp::stream::TcpStream
        registration: 0xA2
        ready: writable
        waker: the reader slot, task 2001
    route:
        0xA1 tokio_rustls::client::TlsStream<tokio::net::tcp::stream::TcpStream>
