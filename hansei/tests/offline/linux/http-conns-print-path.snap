---
source: hansei/src/offline.rs
description: "`print conn` over linux/http-conns"
---
hyper::proto::h1::conn::Conn<reqwest::connect::sealed::Conn, bytes::bytes::Bytes, hyper::proto::h1::role::Client> {
    version: http::version::Version = Http::Http11,
    keep_alive: hyper::proto::h1::conn::KA = Busy,
    reading: hyper::proto::h1::conn::Reading = Init,
    writing: hyper::proto::h1::conn::Writing = KeepAlive,
    method: core::option::Option<http::method::Method> = Some(http::method::Inner { .. } @ 0xA1),
    read_buf_len: 0,
    read_buf_cap: 8192,
}
