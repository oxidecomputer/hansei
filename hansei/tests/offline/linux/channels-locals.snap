---
source: hansei/src/offline.rs
description: "`locals` over linux/channels"
---
notify: &tokio::sync::notify::Notify = 0xA1 -> tokio::sync::notify::Notify {
          state: state=waiting, generation=0,
          mutex: locked=false, parked=false,
          queue: [
              tokio::sync::notify::Waiter { notification: kind=none, order=fifo, waker: tokio::loom::std::unsafe_cell::UnsafeCell<core::option::Option<core::task::wake::Waker>> { .. } @ 0xA2 (task 2001) },
          ],
      }
state: tokio::sync::notify::State = Waiting
notify_waiters_calls: usize = 0
waiter: tokio::sync::notify::Waiter {
      pointers: tokio::util::linked_list::Pointers<tokio::sync::notify::Waiter> {
          inner: tokio::util::linked_list::PointersInner<tokio::sync::notify::Waiter> {
              prev: core::option::Option<core::ptr::non_null::NonNull<tokio::sync::notify::Waiter>> { .. } @ 0xA3 (task 2001),
              next: core::option::Option<core::ptr::non_null::NonNull<tokio::sync::notify::Waiter>> { .. } @ 0xA4 (task 2001),
          },
      },
      waker: core::option::Option<core::task::wake::Waker> = Some(task 2001),
      notification: tokio::sync::notify::AtomicNotification = 0,
  }
