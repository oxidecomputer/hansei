    io: core::option::Option<mio::net::uds::stream::UnixStream>::Some(9),
    registration: tokio::runtime::io::registration::Registration {
        handle: <elided>,
        shared: alloc::sync::Arc<tokio::runtime::io::scheduled_io::ScheduledIo, alloc::alloc::Global> {
            ptr: 0xADDR -> alloc::sync::ArcInner<tokio::runtime::io::scheduled_io::ScheduledIo> { .. },
