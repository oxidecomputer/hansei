---
source: hansei/src/offline.rs
description: "`threads 1` over illumos/nested-await"
---
lwp 1  polling no task
  thread_id: core::option::Option<tokio::runtime::thread_id::ThreadId>::None
  runtime:
    tokio::runtime::context::runtime::EnterRuntime::Entered {
        allow_block_in_place: true,
    }
  budget: core::option::Option<u8>::None
  not in the scheduler's run loop
  stack:
    0xADDR  
    0xADDR  
    0xADDR  
    0xADDR  
    0xADDR  
    0xADDR  <parking_lot::condvar::Condvar>::wait_until_internal
    0xADDR  <tokio::runtime::park::Inner>::park
    0xADDR  nested_await::main
    0xADDR  std::sys::backtrace::__rust_begin_short_backtrace::<fn(), ()>
    0xADDR  std::rt::lang_start::<()>::{closure#0}
    0xADDR  std::rt::lang_start_internal
    0xADDR  main
    0xADDR  _start_crt
    0xADDR  _start
