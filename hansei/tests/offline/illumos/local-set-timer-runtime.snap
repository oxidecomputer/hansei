                  data: core::cell::UnsafeCell<tokio::time::clock::Inner> { .. } @ 0xADDR,
              },
          },
      }
    shared:
      tokio::runtime::scheduler::current_thread::Shared {
          inject: tokio::runtime::scheduler::inject::Inject<alloc::sync::Arc<tokio::runtime::scheduler::current_thread::Handle, alloc::alloc::Global>> {
              shared: tokio::runtime::scheduler::inject::shared::Shared<alloc::sync::Arc<tokio::runtime::scheduler::current_thread::Handle, alloc::alloc::Global>> {
                  len: 0,
