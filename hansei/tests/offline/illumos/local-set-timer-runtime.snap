          owned: tokio::runtime::task::list::OwnedTasks<alloc::sync::Arc<tokio::runtime::scheduler::current_thread::Handle, alloc::alloc::Global>> {
              list: tokio::util::sharded_list::ShardedList<tokio::runtime::task::Task<alloc::sync::Arc<tokio::runtime::scheduler::current_thread::Handle, alloc::alloc::Global>>, tokio::runtime::task::core::Header> { .. } @ 0xADDR,
              id: 1,
              closed: core::sync::atomic::Atomic<bool> {
                  v: 0,
              },
          },
          woken: core::sync::atomic::Atomic<bool> {
              v: 0,
          },
          config: tokio::runtime::config::Config {
              global_queue_interval: core::option::Option<u32> { .. } @ 0xADDR,
              event_interval: 61,
              before_park: core::option::Option<alloc::sync::Arc<(dyn core::ops::function::Fn<(), Output=()> + core::marker::Send + core::marker::Sync), alloc::alloc::Global>> { .. } @ 0xADDR,
              after_unpark: core::option::Option<alloc::sync::Arc<(dyn core::ops::function::Fn<(), Output=()> + core::marker::Send + core::marker::Sync), alloc::alloc::Global>> { .. } @ 0xADDR,
              before_spawn: core::option::Option<alloc::sync::Arc<(dyn core::ops::function::Fn<(&tokio::runtime::task_hooks::TaskMeta), Output=()> + core::marker::Send + core::marker::Sync), alloc::alloc::Global>> { .. } @ 0xADDR,
              after_termination: core::option::Option<alloc::sync::Arc<(dyn core::ops::function::Fn<(&tokio::runtime::task_hooks::TaskMeta), Output=()> + core::marker::Send + core::marker::Sync), alloc::alloc::Global>> { .. } @ 0xADDR,
              before_poll: core::option::Option<alloc::sync::Arc<(dyn core::ops::function::Fn<(&tokio::runtime::task_hooks::TaskMeta), Output=()> + core::marker::Send + core::marker::Sync), alloc::alloc::Global>> { .. } @ 0xADDR,
              after_poll: core::option::Option<alloc::sync::Arc<(dyn core::ops::function::Fn<(&tokio::runtime::task_hooks::TaskMeta), Output=()> + core::marker::Send + core::marker::Sync), alloc::alloc::Global>> { .. } @ 0xADDR,
              disable_lifo_slot: true,
              seed_generator: tokio::util::rand::rt::RngSeedGenerator {
