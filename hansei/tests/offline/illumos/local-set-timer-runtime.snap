                  inner: mio::sys::unix::waker::Waker {
                      fd: std::fs::File {
                          inner: std::sys::fs::unix::File = std::os::fd::owned::OwnedFd {
                              fd: 4,
                          },
                      },
                  },
              },
              metrics: tokio::runtime::metrics::io::IoDriverMetrics { .. } @ 0xADDR,
          },
